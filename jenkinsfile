pipeline {
    agent any 
    
    stages {
         stage('Checkout') {
              steps {
                  git branch: 'main', url: 'https://github.com/porchelvan33/jenkins-1.git'
              }
          }
          stage('Build') {
              steps {
                  sh 'echo Building the project... > build.log'
              }
          }
          stage('Test') {
                steps {
                   sh 'echo running tests... >> build.log'
                }
          }
          stage('Deploy') {
               steps {
                   sh 'echo Deploying application... >> build.log'
               }
          }
    }
    post {
       success {
          echo 'Pipeline completed successfully!'
          archiveArtifacts artifacts: 'build.log', fingerprint: true
         }
         failure {
             echo 'Pipeline failed. Check console output for details.'
        }
        always {
            echo 'Pipeline run finished (success or failure).'
        }
    }
}    

